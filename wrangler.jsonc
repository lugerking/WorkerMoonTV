{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "workermoontv",
  "main": "cf-worker/index.ts",
  "triggers": {
    // 每日 22:00（北京时间）= 14:00 UTC：刷新播放记录并清理图片缓存
    "crons": ["0 14 * * *"]
  },
  "compatibility_date": "2025-08-16",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "workermoontv.mytvapp.qzz.io",
      "custom_domain": true
    },
    {
      "pattern": "mytvapp.qzz.io",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "moontvdatabase",
      "database_id": "add6fcbb-3ca2-4624-b831-a1f61bd5da60"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CONFIG_KV",
      "id": "103d6ff3d73a40b6bd73c1749f27332c"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGE_CACHE",
      "bucket_name": "moontv-image-cache"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_STORAGE_TYPE": "d1",
    "NEXT_PUBLIC_IMAGE_PROXY": "/api/image-proxy?url=",
    "USERNAME": "lugerking"
  },
  "observability": {
    "enabled": true
  }
}
